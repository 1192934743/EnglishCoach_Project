# ============================================================
# EnglishCoach Backend - 环境配置模板
# ============================================================
# 使用说明：
# 1. 复制此文件为 config.env（在同一目录下）
# 2. 填写所有必填项的密钥
# 3. config.env 已在 .gitignore 中，不会提交到 Git
# ============================================================

# ==================== 必填项 ====================

# -------- 大模型 (DeepSeek) --------
DEEPSEEK_KEY=
DEEPSEEK_BASE=https://api.deepseek.com

# -------- 火山引擎 (ASR + TTS) --------
VOLC_API_KEY=
# ASR 资源 ID
VOLC_RESOURCE_ID=
# TTS 资源 ID
VOLC_RESOURCE_ID_TTS=

# ==================== 可选项 (有默认值) ====================

# -------- 语音识别 (ASR) --------
# ASR 语言设置
ASR_LANGUAGE=en-US

# -------- 语音合成 (TTS) --------
# 默认 TTS 引擎: azure 或 volcengine
DEFAULT_TTS_ENGINE=azure

# 音色设置
# Azure TTS 音色
AZURE_VOICE=en-GB-RyanNeural
# 火山引擎 TTS 音色
VOLC_VOICE=en_male_tim_uranus_bigtts

# -------- Azure TTS (可选，如使用 azure 引擎) --------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

# -------- TTS 连接池预热 (可选) --------
# 预热连接数量
TTS_WARM_POOL_SIZE=2
# 连接超时时间(秒)
TTS_WARM_TIMEOUT_SEC=300
# 数据库路径 (Docker 部署建议保持默认，通过 volume 映射)
DATABASE_URL=sqlite:///./data/english_coach.db

# ==================== 其他 (可选) ====================

# 时区 (Docker 部署时日志时间戳将使用此设置)
TZ=Asia/Shanghai

# HTTP 代理 (如需要)
# HTTP_PROXY=http://127.0.0.1:7897

# Gemini API Key (用于部分脚本)
# GEMINI_API_KEY=
